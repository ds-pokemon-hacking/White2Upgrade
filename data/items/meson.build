# Items (/a/0/2/4)
items_arc = 'a' / '0' / '2' / '4'
foreach item : items
  item_name = fs.replace_suffix(item, '')
  vfs_files += custom_target(
    'item_' + item_name,
    input: meson.current_source_dir() / item,
    output: item_name,
    command: [mkdata_py, 'generic', '@INPUT@', meson.project_build_root() / '@OUTPUT@', 'format', 'items'],
  )
endforeach